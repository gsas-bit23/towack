# Towack web — public config only. Never put private keys, mnemonics, or API secrets here:
# every NEXT_PUBLIC_* value is shipped to the browser.

# WalletConnect / Reown Cloud project id (https://cloud.reown.com). Optional:
# without it, the app still builds and offers injected browser wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# 97 = BSC testnet (default), 56 = BSC mainnet
NEXT_PUBLIC_DEFAULT_CHAIN_ID=97

# Optional address overrides (take precedence over src/config/addresses.json).
# BSC testnet (97)
NEXT_PUBLIC_TOWACK_97_AGENT_ID=
NEXT_PUBLIC_TOWACK_97_TOKEN=
NEXT_PUBLIC_TOWACK_97_LAUNCH=
NEXT_PUBLIC_TOWACK_97_ROUTER=
NEXT_PUBLIC_TOWACK_97_REBATE_DISTRIBUTOR=
NEXT_PUBLIC_TOWACK_97_TEAM_VESTING=
NEXT_PUBLIC_TOWACK_97_DRAW_V2=
NEXT_PUBLIC_TOWACK_97_TIMELOCK=
# BSC mainnet (56)
NEXT_PUBLIC_TOWACK_56_AGENT_ID=
NEXT_PUBLIC_TOWACK_56_TOKEN=
NEXT_PUBLIC_TOWACK_56_LAUNCH=
NEXT_PUBLIC_TOWACK_56_ROUTER=
NEXT_PUBLIC_TOWACK_56_REBATE_DISTRIBUTOR=
NEXT_PUBLIC_TOWACK_56_TEAM_VESTING=
NEXT_PUBLIC_TOWACK_56_DRAW_V2=
NEXT_PUBLIC_TOWACK_56_TIMELOCK=
